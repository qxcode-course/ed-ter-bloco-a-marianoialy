            "content": "package main\n\nimport \"fmt\"\n\ntype Pos struct {\n\tl, c int\n}\n\nfunc (p Pos) getNeig() []Pos {\n\treturn []Pos{\n\t\t{p.l + 1, p.c},\n\t\t{p.l - 1, p.c},\n\t\t{p.l, p.c + 1},\n\t\t{p.l, p.c - 1},\n\t}\n}\nfunc orangesRotting(grid [][]int) int {\n\tq := []Pos{}\n\tmin := 0\n\tfresh := 0\n\n\tfor i := 0; i < len(grid); i++ {\n\t\tfor j := 0; j < len(grid[0]); j++ {\n\t\t\tif grid[i][j] == 2 {\n\t\t\t\tq = append(q, Pos{i, j})\n\t\t\t}\n\t\t\tif grid[i][j] == 1 {\n\t\t\t\tfresh++\n\t\t\t}\n\t\t}\n\t}\n\tif fresh == 0 {\n\t\treturn 0\n\t}\n\tfor len(q) > 0 {\n\t\tsize := len(q)\n\t\talterado := false\n\t\tfor i := 0; i < size; i++ {\n\t\t\tatual := q[0]\n\t\t\tq = q[1:]\n\n\t\t\tfor _, v := range atual.getNeig() {\n\t\t\t\tif v.l >= 0 && v.l < len(grid) && v.c >= 0 && v.c < len(grid[0]) && grid[v.l][v.c] == 1 {\n\t\t\t\t\tgrid[v.l][v.c] = 2\n\t\t\t\t\tfresh--\n\t\t\t\t\tq = append(q, v)\n\t\t\t\t\talterado = true\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tmin++\n\t\tif !alterado {\n\t\t\tmin--\n\t\t\tbreak\n\t\t}\n\t}\n\tif fresh > 0 {\n\t\treturn -1\n\t}\n\treturn min\n}\nfunc main() {\n\tvar m, n int\n\tfmt.Scan(&m, &n)\n\n\tgrid := make([][]int, m)\n\tfor i := 0; i < m; i++ {\n\t\tgrid[i] = make([]int, n)\n\t\tfor j := 0; j < n; j++ {\n\t\t\tfmt.Scan(&grid[i][j])\n\t\t}\n\t}\n\tfmt.Println(orangesRotting(grid))\n}\n",
